\mode<presentation>

\definecolor{azulTEC}{HTML}{275DA8}
\definecolor{azulClaro}{HTML}{EAF2FB}
\definecolor{cafeTEC}{HTML}{9A6A00}
\definecolor{cafeClaro}{HTML}{FFF8E5}
\definecolor{azulTabla}{HTML}{D9EEF8}
\definecolor{grisEncabezado}{HTML}{B9B9B9}
\definecolor{grisTexto}{HTML}{30343B}

% Colores generales
\setbeamercolor{normal text}{
    fg=grisTexto,
    bg=white
}

\setbeamercolor{alerted text}{
    fg=cafeTEC
}

\setbeamercolor{structure}{
    fg=azulTEC
}

\setbeamercolor{title}{
    fg=azulTEC
}

\setbeamercolor{subtitle}{
    fg=grisTexto
}

\setbeamercolor{frametitle}{
    fg=azulTEC,
    bg=white
}

\setbeamercolor{framesubtitle}{
    fg=grisTexto
}

% Pie de página
\setbeamercolor{footline}{
    fg=grisTexto,
    bg=white
}

% Bloque normal
\setbeamercolor{block title}{
    fg=white,
    bg=azulTEC
}

\setbeamercolor{block body}{
    fg=grisTexto,
    bg=azulClaro
}

% Bloque de ejemplo
\setbeamercolor{block title example}{
    fg=white,
    bg=cafeTEC
}

\setbeamercolor{block body example}{
    fg=grisTexto,
    bg=cafeClaro
}

% Bloque de alerta
\setbeamercolor{block title alerted}{
    fg=white,
    bg=red!70!black
}

\setbeamercolor{block body alerted}{
    fg=grisTexto,
    bg=red!8
}

% Elementos enumerados
\setbeamercolor{itemize item}{
    fg=azulTEC
}

\setbeamercolor{itemize subitem}{
    fg=cafeTEC
}

\setbeamercolor{enumerate item}{
    fg=azulTEC
}

% Tablas y elementos secundarios
\setbeamercolor{palette primary}{
    fg=white,
    bg=azulTEC
}

\setbeamercolor{palette secondary}{
    fg=grisTexto,
    bg=azulClaro
}

\setbeamercolor{palette tertiary}{
    fg=grisTexto,
    bg=azulTabla
}

\setbeamercolor{palette quaternary}{
    fg=grisTexto,
    bg=grisEncabezado
}

\setbeamercolor{progress bar background}{
    bg=azulClaro
}

\mode<all>